# 1. MASTER ADMIN PASSWORD (RECOMMENDED FOR VERCEL DEPLOYMENT)
# In Vercel Project Settings -> Environment Variables:
#   Key: ADMIN_PASSWORD
#   Value: your_super_secure_password_here
#   Type: Secret  <-- (Zero warnings in Vercel! Server-side only, never leaked to client)
ADMIN_PASSWORD=webbits2026

# 2. LOCAL DEV / VITE FALLBACK (OPTIONAL)
# If using in local dev without Vercel Serverless runtime:
# Note: In Vercel, any variable starting with "VITE_" must be set as "Type: Config", NOT "Secret".
VITE_ADMIN_PASSWORD=webbits2026

# 3. GLOBAL MULTI-REGION PERSISTENCE (OPTIONAL - Vercel KV / Upstash Redis)
# Connect free Vercel KV or Upstash Redis to persist tool toggles & analytics forever:
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...
# Or Upstash:
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...

